# ==============================================================================
# Progressive Credential Loading (PCL) Configuration
# Repository: enterprise-iam-auth-poc-node
# ==============================================================================
#
# TIER 1: ZERO-SETUP / LOCAL DEV / CI (Default)
# - In-memory user directory and dev JWT secret.
#
# TIER 2 / TIER 3: PRODUCTION RBAC & REDIS SESSION STORE
# - Provide strong JWT secret, Redis URL, and PostgreSQL DB.

JWT_SECRET=dev-secret-replace-in-production-min32chars
DATABASE_URL=
REDIS_URL=
SESSION_TTL_MS=86400000
PORT=3000
